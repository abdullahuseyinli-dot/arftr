      "h_seconds": "4/30 for long-valid rows and 1/30 for exact-short-fallback rows",
      "slope": "(D[k+1]-D[k-1])/(2*h)",
      "center_curvature": "(D[k]-(D[k-1]+D[k+1])/2)/(h*h)",
      "curvature_convention": "negative one-half of the conventional second finite difference"
    },
    "signed_change_width": 1536,
    "unsigned_control": "elementwise absolute value of both signed-change blocks after their signed derivation; preserve signed center-anchor features",
